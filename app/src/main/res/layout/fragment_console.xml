<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ======== 连接状态栏 ======== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvStatusDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="@color/status_disconnected"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/not_connected"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConnInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conn_info_default"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnUuidSetting"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/ble_setting" />

        <Button
            android:id="@+id/btnConnect"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/connect" />

        <Button
            android:id="@+id/btnDisconnect"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/disconnect" />
    </LinearLayout>

    <!-- ======== 接收区 ======== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spRxFormat"
                android:layout_width="76dp"
                android:layout_height="wrap_content" />

            <Spinner
                android:id="@+id/spCharset"
                android:layout_width="82dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <CheckBox
                android:id="@+id/cbTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/timestamp"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/more_menu"
                android:src="@drawable/ic_more"
                android:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- 收发计数(上下两行,整行显示) -->
        <TextView
            android:id="@+id/tvRxStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            tools:ignore="RtlSymmetry" />

        <ScrollView
            android:id="@+id/scrollReceive"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:background="?attr/colorSurfaceContainerHighest"
            android:fillViewport="true"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvReceive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:text="@string/receive_placeholder"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </ScrollView>
    </LinearLayout>

    <!-- ======== 发送区(紧凑,给接收区留出面积) ======== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLow"
        android:orientation="vertical"
        android:padding="8dp">

        <EditText
            android:id="@+id/etSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:hint="@string/send_hint"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:minLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spTxFormat"
                android:layout_width="76dp"
                android:layout_height="wrap_content" />

            <Spinner
                android:id="@+id/spTxCharset"
                android:layout_width="82dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp" />

            <Spinner
                android:id="@+id/spLineEnd"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnHistory"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/send_history" />

            <Button
                android:id="@+id/btnSend"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/send" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbLoop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loop_send"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etInterval"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:inputType="number"
                android:maxLength="6"
                android:text="1000"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/ms_label"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
